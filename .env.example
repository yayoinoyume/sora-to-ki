# ═══════════════════════════════════════════════════════════
#  sora-to-ki 环境变量
#
#  复制成 .env.backend（compose 的 env_file 读这个档名）之后按需填写。
#  本机直接 cargo run 时复制成 backend/.env。
#  没填的可选项都会有降级行为：
#  对应的区块显示空状态、或那条第三方同步不启动，不会让站点起不来。
#
#  ⚠ 这个文件是模板，不要填真实凭据后提交。
# ═══════════════════════════════════════════════════════════

# ── 必填 ────────────────────────────────────────────────────

# JWT 签名密钥。随便一串足够长的随机字串，改掉会让所有已登录用户失效。
JWT_SECRET=

# 后台管理员账号。ENABLE_RESET_ADMIN 设成 1 时，启动阶段会用这两个值重建这个账号。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 站点的对外网址（不带结尾斜线）。影响 canonical、RSS、sitemap、邮件里的链接。
# ⚠ docker compose 部署时这一项由 compose 的 environment 指定，改这里不生效。
SITE_URL=https://example.com

# SQLite 数据库。目录必须已存在，文件不存在会自动建。
# ⚠ docker compose 部署时由 compose 指定（volume 上的路径），改这里不生效。
DATABASE_URL=sqlite://./db/db.sqlite

# 后端监听地址。⚠ compose 部署时由 compose 指定，改这里不生效。
BIND_ADDR=0.0.0.0:8080

# 连接池上限
DATABASE_MAX_CONNECTIONS=8

# ── 可选：第三方数据（不配则该区块显示空状态）──────────────

# GitHub：Token 用于 GraphQL（作品页、贡献图）、GITHUB_REPO 是站点自己的仓库
GITHUB_TOKEN=
GITHUB_REPO=example-user/sora-to-ki

# Steam：最近在玩
STEAM_ID=
STEAM_API_KEY=

# Spotify：正在听。refresh token 用 scripts/spotify-reauth.mjs 拿
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://localhost:8080/api/spotify/callback

# WakaTime：这周写了多久
WAKATIME_API_KEY=

# Simkl：在看什么
SIMKL_CLIENT_ID=
SIMKL_ACCESS_TOKEN=
SIMKL_BASE_URL=https://api.simkl.com
SIMKL_SYNC_PERIOD_SECS=3600
SIMKL_SYNC_DELAY_SECS=30

# TMDb：收藏页的海报
TMDB_API_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Google Books：书籍搜索
GOOGLE_BOOKS_API_KEY=

# 巴哈姆特动画疯（需要登入态 cookie）
BAHAMUT_COOKIE=
BAHAMUT_COOKIE_FILE=
BAHAMUT_UID=
BAHAMUT_PASSWORD=
BAHAMUT_PUSH_TOKEN=

# Discord：推送通知用的 webhook
DISCORD_WEBHOOK_URL=

# 照片：AI 打标服务（不配就只存原图，不生成标签）
PHOTO_TAGGER_URL=
PHOTO_TAGGER_GALLERY_PREFIX=
PHOTO_TAGGER_TIMEOUT_MS=30000

# 影音转码工具路径（不配则用 PATH 里的）
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# 相册同步（scripts/builder 与后端 gallery 共用）
GALLERY_SOURCE_PATH=./data/gallery
GALLERY_OUTPUT_DIR=./data/gallery-out
GALLERY_MANIFEST_PATH=./data/gallery-manifest.json
UPLOAD_BASE_DIR=./data/uploads

# ── 可选：登录 ─────────────────────────────────────────────

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 用这个邮箱登入的人会被标成 OWNER（唯一的站长权限）。
# 换站时改成自己的邮箱；保持 no-reply@example.com 的话谁都拿不到 OWNER。
OWNER_EMAIL=no-reply@example.com

# ── 可选：基础设施 ─────────────────────────────────────────

# 错误上报（Sentry 协议，自架 GlitchTip 也行）
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TUNNEL_PUBLIC_KEY=
SENTRY_SMOKE_TEST=

# Plausible 统计
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=example.com

# 电子报（Resend）
RESEND_API_KEY=
NEWSLETTER_FROM=Example Site <no-reply@example.com>
NEWSLETTER_REPLY_TO=

# 前台重新验证（部署后让 CDN 或 ISR 立刻拿到新内容）
REVALIDATE_SECRET=
FRONTEND_REVALIDATE_URL=

# og 图：只生成指定语系（逗号分隔，空=全部）
OG_LOCALES=
# 设成 1 时把生成的样张写到临时目录，供人工检查
OG_PREVIEW=

# 启动时用 ADMIN_USERNAME / ADMIN_PASSWORD 重建管理员（危险，平时留空）
ENABLE_RESET_ADMIN=
